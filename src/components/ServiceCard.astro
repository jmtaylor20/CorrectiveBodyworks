---
import Icon from './Icon.astro';
import type { Service } from '../data/services';

interface Props {
  service: Service;
  detailed?: boolean;
}
const { service, detailed = false } = Astro.props;
---

<article class="svc reveal" id={detailed ? service.slug : undefined}>
  <span class="svc__icon"><Icon name={service.icon} size={26} /></span>
  <h3>{service.title}</h3>
  <p class="svc__summary">{service.summary}</p>
  {detailed && <p class="svc__detail">{service.detail}</p>}
</article>

<style>
  .svc {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 2.6vw, 2.25rem);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease),
      border-color 0.3s var(--ease);
    scroll-margin-top: 120px;
  }

  .svc:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--slate-300);
  }

  .svc__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--bg-alt);
    color: var(--slate-600);
    margin-bottom: 1.25rem;
  }

  .svc h3 {
    margin-bottom: 0.65rem;
  }

  .svc__summary {
    color: var(--text-muted);
    font-size: 1rem;
  }

  .svc__detail {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.975rem;
    color: var(--text-muted);
  }
</style>
