---
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'Ready to move without pain?',
  body = 'Tell us what is going on and we will help you figure out the next step. New patients are welcome.',
} = Astro.props;
---

<section class="section section--deep cta">
  <div class="wrap cta__inner">
    <div>
      <p class="eyebrow">Get started</p>
      <h2>{heading}</h2>
      <p class="lede cta__body">{body}</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--invert" href="/contact/">{site.booking.label}</a>
      <a class="btn btn--outline-invert" href={site.phoneHref}>
        <Icon name="phone" size={17} />
        {site.phone}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
  }

  .cta::after {
    content: '';
    position: absolute;
    inset-block: -30%;
    right: -8%;
    width: 46%;
    background: radial-gradient(
      circle at 60% 50%,
      rgba(76, 100, 122, 0.5),
      transparent 62%
    );
    pointer-events: none;
  }

  .cta__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) auto;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .cta__body {
    margin-top: 1rem;
    max-width: 52ch;
  }

  .cta__actions {
    display: grid;
    gap: 0.9rem;
    justify-items: stretch;
  }

  @media (max-width: 820px) {
    .cta__inner {
      grid-template-columns: 1fr;
    }
    .cta__actions {
      justify-items: start;
    }
  }
</style>
