---
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap ftr__grid">
    <div class="ftr__brand">
      <img src="/logo-horizontal-white.png" alt={site.name} width="2500" height="885" loading="lazy" />
      <p>{site.description}</p>
    </div>

    <div class="ftr__col">
      <h3>Visit</h3>
      <address>
        <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
          {site.address.street}<br />
          {site.address.city}, {site.address.state} {site.address.zip}
        </a>
      </address>
      <p class="ftr__contact">
        <a href={site.phoneHref}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>

    <div class="ftr__col">
      <h3>Hours</h3>
      <ul class="ftr__hours">
        {
          site.hours.map((h) => (
            <li>
              <span>{h.day}</span>
              <span>{h.time}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="ftr__col">
      <h3>Explore</h3>
      <ul class="ftr__links">
        <li><a href="/">Home</a></li>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/patient-portal/">Patient Portal</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap ftr__base">
    <p>&copy; {year} {site.legalName}. All rights reserved.</p>
    <p class="ftr__note">
      This site is for general information only and is not a substitute for individual
      medical advice.
    </p>
  </div>
</footer>

<style>
  .ftr {
    background: var(--navy-900);
    color: var(--text-invert-muted);
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
  }

  .ftr__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    grid-template-columns: 1.4fr 1.15fr 0.95fr 0.85fr;
    padding-bottom: 3rem;
  }

  .ftr__brand img {
    width: 230px;
    margin-bottom: 1.25rem;
  }

  .ftr__brand p {
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 34ch;
  }

  .ftr h3 {
    font-size: 0.8125rem;
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-invert);
    margin-bottom: 1.1rem;
  }

  .ftr a {
    color: var(--text-invert-muted);
    text-decoration: none;
    overflow-wrap: break-word;
  }

  .ftr a:hover {
    color: var(--text-invert);
    text-decoration: underline;
  }

  .ftr address {
    font-style: normal;
    line-height: 1.6;
  }

  .ftr__contact {
    margin-top: 0.9rem;
    line-height: 1.8;
  }

  .ftr__hours,
  .ftr__links {
    list-style: none;
    padding: 0;
    font-size: 0.95rem;
  }

  .ftr__hours li {
    display: flex;
    flex-direction: column;
    margin-bottom: 0.7rem;
  }

  .ftr__hours span:first-child {
    color: var(--text-invert);
    font-weight: 600;
  }

  .ftr__links li + li {
    margin-top: 0.6rem;
  }

  .ftr__base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.85rem;
  }

  .ftr__note {
    max-width: 46ch;
    opacity: 0.72;
  }

  @media (max-width: 900px) {
    .ftr__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .ftr__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .ftr__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
