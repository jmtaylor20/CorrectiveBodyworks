---
import { site, nav } from '../data/site';
import BookButton from './BookButton.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href;
---

<!-- Utility strip. Scrolls away; the main header below it stays sticky. -->
<div class="util">
  <div class="wrap util__inner">
    <a class="util__link util__addr" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <path d="M12 21s7-6.4 7-11a7 7 0 1 0-14 0c0 4.6 7 11 7 11z" />
        <circle cx="12" cy="10" r="2.5" />
      </svg>
      <span>{site.address.city}, {site.address.state}</span>
    </a>

    <a class="util__link util__tel" href={site.phoneHref} aria-label={`Call ${site.phone}`}>
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.6a1 1 0 0 1-.25 1z" />
      </svg>
      <span>{site.phone}</span>
    </a>

    <a class="util__portal" href="/patient-portal/">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="4" y="10.5" width="16" height="10" rx="2" />
        <path d="M8 10.5V7a4 4 0 0 1 8 0v3.5" />
      </svg>
      <span>Patient Portal<span class="util__login"> Login</span></span>
    </a>
  </div>
</div>

<header class="hdr" data-header>
  <div class="wrap hdr__inner">
    <a class="hdr__brand" href="/" aria-label={`${site.name}, home`}>
      <img
        src="/logo-horizontal.png"
        alt={`${site.name} ${site.tagline}`}
        width="2500"
        height="885"
        fetchpriority="high"
      />
    </a>

    <nav class="hdr__nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr__actions">
      <a class="hdr__phone" href={site.phoneHref}>
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <path
            fill="currentColor"
            d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.6a1 1 0 0 1-.25 1z"
          ></path>
        </svg>
        <span>{site.phone}</span>
      </a>
      <BookButton class="hdr__cta" />
    </div>

    <button class="hdr__toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-toggle>
      <span class="visually-hidden">Menu</span>
      <span class="hdr__bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>

  <nav class="mnav" id="mobile-nav" aria-label="Mobile" data-mobile hidden>
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
    <div class="mnav__foot">
      <BookButton />
      <a class="mnav__phone" href={site.phoneHref}>{site.phone}</a>
    </div>
  </nav>
</header>

<style>
  .util {
    background: var(--navy-900);
    color: var(--text-invert-muted);
    font-size: 0.8125rem;
  }

  .util__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 40px;
  }

  .util a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .util a:hover {
    color: #fff;
  }

  .util__link svg {
    opacity: 0.8;
  }

  .util__tel {
    margin-right: auto;
  }

  /* The main header already shows the phone at desktop widths. Only surface
     it up here once the header collapses to the hamburger. */
  @media (min-width: 1241px) {
    /* `.util a` sets display, so match its specificity to override it. */
    .util a.util__tel {
      display: none;
    }
    .util a.util__addr {
      margin-right: auto;
    }
  }

  .util__portal {
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff !important;
    padding: 0.35rem 0.9rem;
    margin-right: -0.9rem;
    border-left: 1px solid rgba(255, 255, 255, 0.18);
    padding-left: 1.25rem;
  }

  .util__portal:hover {
    color: var(--mist-200) !important;
  }

  @media (max-width: 700px) {
    .util a.util__addr {
      display: none;
    }
    .util__inner {
      gap: 1rem;
      justify-content: space-between;
    }
    .util__portal {
      border-left: 0;
      padding-left: 0;
      margin-right: 0;
      font-size: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .util__login {
      display: none;
    }
    .util__inner {
      gap: 0.6rem;
    }
    .util a {
      font-size: 0.72rem;
    }
    .util svg {
      width: 12px;
      height: 12px;
    }
  }

  /* Narrowest phones: keep the tap-to-call icon, drop the digits, so the
     portal link always fits. */
  @media (max-width: 380px) {
    .util__tel span {
      display: none;
    }
  }

  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
    transition: box-shadow 0.3s var(--ease);
  }

  .hdr[data-scrolled] {
    box-shadow: var(--shadow-sm);
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 88px;
  }

  .hdr__brand {
    flex: none;
    line-height: 0;
  }

  .hdr__brand img {
    width: clamp(180px, 20vw, 250px);
    height: auto;
  }

  .hdr__nav {
    margin-left: auto;
  }

  .hdr__nav ul {
    display: flex;
    gap: clamp(1.25rem, 2.4vw, 2.25rem);
    list-style: none;
    padding: 0;
  }

  .hdr__nav a {
    position: relative;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--navy-900);
    padding-block: 0.4rem;
    white-space: nowrap;
  }

  .hdr__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--slate-600);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .hdr__nav a:hover::after,
  .hdr__nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .hdr__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex: none;
  }

  .hdr__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--navy-900);
    text-decoration: none;
    white-space: nowrap;
  }

  .hdr__phone:hover {
    color: var(--slate-600);
  }

  .hdr__cta {
    padding: 0.75rem 1.4rem;
    font-size: 0.8125rem;
  }

  .hdr__toggle {
    display: none;
    margin-left: auto;
    background: none;
    border: 0;
    padding: 0.6rem;
    cursor: pointer;
    color: var(--navy-900);
  }

  .hdr__bars {
    display: grid;
    gap: 5px;
    width: 26px;
  }

  .hdr__bars i {
    display: block;
    height: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease), opacity 0.2s var(--ease);
  }

  .hdr__toggle[aria-expanded='true'] i:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hdr__toggle[aria-expanded='true'] i:nth-child(2) {
    opacity: 0;
  }
  .hdr__toggle[aria-expanded='true'] i:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mnav {
    border-top: 1px solid var(--border);
    background: #fff;
    padding: 1.25rem var(--gutter) 2rem;
  }

  .mnav[hidden] {
    display: none;
  }

  .mnav ul {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .mnav ul a {
    display: block;
    padding: 0.9rem 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--navy-900);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }

  .mnav__foot {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.5rem;
    justify-items: start;
  }

  .mnav__phone {
    font-weight: 700;
    color: var(--navy-900);
    text-decoration: none;
  }

  @media (max-width: 1240px) {
    .hdr__nav,
    .hdr__actions {
      display: none;
    }
    .hdr__toggle {
      display: block;
    }
  }

  @media (min-width: 1241px) {
    .mnav {
      display: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-toggle]');
  const mobile = document.querySelector('[data-mobile]');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (mobile) (mobile as HTMLElement).hidden = open;
  });

  const onScroll = () => {
    if (window.scrollY > 8) header?.setAttribute('data-scrolled', '');
    else header?.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
