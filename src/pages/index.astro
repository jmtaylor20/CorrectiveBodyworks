---
import Base from '../layouts/Base.astro';
import Directions from '../components/Directions.astro';
import CTABanner from '../components/CTABanner.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Icon from '../components/Icon.astro';
import BookButton from '../components/BookButton.astro';
import { site } from '../data/site';
import { services, differentiators } from '../data/services';
import { team } from '../data/team';

const featured = services.slice(0, 6);
---

<Base>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Notasulga, Alabama</p>
        <h1>Relief today.<br /><em>Correction</em> that lasts.</h1>
        <p class="lede hero__lede">
          Outpatient orthopedic physical therapy, manual therapy, and sports medicine
          from clinicians who look past the symptom to the imbalance underneath it.
        </p>
        <div class="btn-row hero__actions">
          <BookButton />
          <a class="btn btn--ghost" href="/services/">Explore Services</a>
        </div>

        <ul class="hero__proof">
          <li><strong>50+</strong><span>Years combined experience</span></li>
          <li><strong>4</strong><span>Advanced manual therapy certifications</span></li>
          <li><strong>1:1</strong><span>Care with your clinician, every visit</span></li>
        </ul>
      </div>

    </div>

      <figure class="hero__panel">
        <img
          src="/jeff-hero.jpg"
          alt="Jeff Cotten, PTA, ATC, LMT, CIDN, owner of Corrective Bodyworks"
          width="900"
          height="1125"
          fetchpriority="high"
        />
        <figcaption>
          <strong>Jeff Cotten</strong>
          <span>PTA, ATC, LMT, CIDN</span>
        </figcaption>
      </figure>
  </section>

  <!-- ── Intro ────────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap intro">
      <div class="reveal">
        <p class="eyebrow">Our approach</p>
        <h2>Pain is the signal.<br />We go after the source.</h2>
      </div>
      <div class="stack reveal">
        <p class="lede">
          Most persistent pain is not a local problem. It is the end result of muscles
          that are overworked, muscles that stopped doing their job, and a body that has
          quietly reorganized itself around an old injury or a long day in a chair.
        </p>
        <p>
          At Corrective Bodyworks we combine advanced hands-on treatment with corrective
          exercise. The manual work brings relief quickly. The corrective work makes it
          stick. That means evaluating how you actually move, treating what we find, and
          giving you the specific tools to lower the chance it comes back.
        </p>
        <p>
          Whether you are an athlete, recovering from surgery, on your feet at work all
          day, or simply tired of hurting, you will be treated by an experienced licensed
          clinician who stays with you from evaluation through discharge.
        </p>
        <a class="arrow-link" href="/about/">
          More about the practice <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- ── Services ─────────────────────────────────────────────────────── -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="sec-head reveal">
        <div>
          <p class="eyebrow">What we do</p>
          <h2>Services</h2>
        </div>
        <p class="lede">
          A full range of rehabilitation and wellness care, delivered one patient at a
          time.
        </p>
      </div>

      <div class="grid cards">
        {featured.map((service) => <ServiceCard service={service} />)}
      </div>

      <div class="sec-foot reveal">
        <a class="btn btn--ghost" href="/services/">View all services</a>
      </div>
    </div>
  </section>

  <!-- ── Why us ───────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <div>
          <p class="eyebrow">Why Corrective Bodyworks</p>
          <h2>What makes us different</h2>
        </div>
      </div>

      <div class="grid diffs">
        {
          differentiators.map((item, i) => (
            <div class="diff reveal">
              <span class="diff__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Team ─────────────────────────────────────────────────────────── -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="sec-head reveal">
        <div>
          <p class="eyebrow">Meet the team</p>
          <h2>Who you'll see</h2>
        </div>
        <p class="lede">
          Two experienced clinicians who treat their own patients, personally.
        </p>
      </div>

      <div class="grid team-grid">
        {
          team.map((member) => (
            <a class="tcard reveal" href={`/team/#${member.slug}`}>
              <div class="tcard__media">
                {member.photo ? (
                  <img src={member.photo} alt={member.name} loading="lazy" width="600" height="800" />
                ) : (
                  <div class="tcard__ph">
                    <span>
                      {member.name
                        .split(' ')
                        .map((n) => n[0])
                        .join('')}
                    </span>
                  </div>
                )}
              </div>
              <div class="tcard__body">
                <h3>{member.name}</h3>
                <p class="tcard__creds">{member.credentials}</p>
                <p class="tcard__lede">{member.lede}</p>
                <span class="arrow-link">
                  Read bio <Icon name="arrow" size={18} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Visit ────────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap visit">
      <div class="reveal">
        <p class="eyebrow">Visit the clinic</p>
        <h2>Find us</h2>
        <ul class="visit__facts">
          <li>
            <Icon name="pin" size={22} />
            <div>
              <strong>Address</strong>
              <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
                {site.address.full}
              </a>
            </div>
          </li>
          <li>
            <Icon name="phone" size={22} />
            <div>
              <strong>Phone</strong>
              <a href={site.phoneHref}>{site.phone}</a>
            </div>
          </li>
          <li>
            <Icon name="clock" size={22} />
            <div>
              <strong>Hours</strong>
              {site.hours.map((h) => <span class="visit__hours">{h.day}: {h.time}</span>)}
            </div>
          </li>
        </ul>

        <Directions tone="plain" />
      </div>

      <!--
        Short version of the /contact/ form. Same Netlify form name so every
        lead lands in one inbox; the hidden `source` field says which page it
        came from. Keep the field names identical to the contact page.
      -->
      <div class="visit__form reveal">
        <h3>Request an appointment</h3>
        <p class="visit__formNote">
          Send a few details and we will call you back. Please keep it general:
          this form is not a secure channel for medical information.
        </p>

        <form
          name="appointment"
          method="POST"
          data-netlify="true"
          netlify-honeypot="company"
          action="/thank-you/"
        >
          <input type="hidden" name="form-name" value="appointment" />
          <input type="hidden" name="source" value="Homepage" />
          <p class="hp">
            <label>Do not fill this out: <input name="company" /></label>
          </p>

          <div class="field-row">
            <div class="field">
              <label for="v-name">Name <span aria-hidden="true">*</span></label>
              <input id="v-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="v-phone">Phone <span aria-hidden="true">*</span></label>
              <input id="v-phone" name="phone" type="tel" autocomplete="tel" required />
            </div>
          </div>

          <div class="field">
            <label for="v-email">Email <span aria-hidden="true">*</span></label>
            <input id="v-email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="v-message">What can we help with?</label>
            <textarea
              id="v-message"
              name="message"
              rows="3"
              placeholder="Briefly, what's bothering you and how long has it been going on?"
            ></textarea>
          </div>

          <div class="consent">
            <label class="consent__row">
              <input type="checkbox" name="consent_contact" value="yes" required />
              <span>
                I agree that Corrective Bodyworks may contact me by phone, text, or
                email about my request. Message and data rates may apply. Reply STOP
                to opt out of texts at any time. <span aria-hidden="true">*</span>
              </span>
            </label>
          </div>

          <button class="btn btn--primary visit__submit" type="submit">Send message</button>
          <p class="visit__alt">
            Prefer to talk? Call <a href={site.phoneHref}>{site.phone}</a>.
          </p>
        </form>
      </div>
    </div>
  </section>

  <CTABanner />
</Base>

<style>
  /* --- hero --- */
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 7rem);
    background: linear-gradient(170deg, var(--bg-alt) 0%, #fff 62%);
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  /* Keeps the copy clear of the photograph without a second grid column. */
  .hero__copy {
    max-width: min(620px, 58%);
  }

  .hero h1 em {
    font-style: normal;
    color: var(--slate-600);
  }

  .hero__lede {
    margin-top: 1.5rem;
    max-width: 54ch;
  }

  .hero__actions {
    margin-top: 2.25rem;
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 3rem);
    list-style: none;
    padding: 2.5rem 0 0;
    margin-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .hero__proof li {
    display: grid;
    gap: 0.15rem;
  }

  .hero__proof strong {
    font-family: var(--font-display);
    font-size: 2.1rem;
    line-height: 1;
    color: var(--navy-900);
  }

  .hero__proof span {
    font-size: 0.85rem;
    color: var(--text-muted);
    max-width: 18ch;
  }

  /* Anchored to the section rather than the centred wrap, so it runs off the
     right edge of the viewport at any width without relying on 100vw, which
     would count the scrollbar and reintroduce horizontal overflow. */
  /* A direct child of the section, not of the centred wrap, so `right: 0`
     means the viewport edge rather than the wrap edge. */
  .hero__panel {
    position: absolute;
    inset-block: 0;
    right: 0;
    width: clamp(340px, 46%, 720px);
    margin: 0;
    z-index: 0;
  }

  .hero__panel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 20%;
    /* Dissolves into whatever sits behind it, so the photograph belongs to
       the page instead of sitting on top of it. */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 38%);
    mask-image: linear-gradient(to right, transparent 0%, #000 38%);
  }

  .hero__panel figcaption {
    position: absolute;
    right: clamp(1.25rem, 3vw, 2.5rem);
    bottom: clamp(1.25rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.7rem 1.1rem;
    background: rgba(1, 27, 58, 0.82);
    backdrop-filter: blur(6px);
    border-radius: var(--radius);
  }

  .hero__panel figcaption strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    color: #fff;
  }

  .hero__panel figcaption span {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mist-200);
  }

  /* --- shared section furniture --- */
  .sec-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 3rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .sec-foot {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: flex;
    justify-content: center;
  }

  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy-900);
    text-decoration: none;
  }

  .arrow-link :global(svg) {
    transition: transform 0.25s var(--ease);
  }

  .arrow-link:hover :global(svg) {
    transform: translateX(4px);
  }

  /* --- intro --- */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* --- cards --- */
  .cards {
    grid-template-columns: repeat(auto-fit, minmax(min(290px, 100%), 1fr));
  }

  /* --- differentiators --- */
  .diffs {
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
  }

  .diff__num {
    display: block;
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--mist-200);
    margin-bottom: 0.75rem;
  }

  .diff h3 {
    margin-bottom: 0.6rem;
  }

  .diff p {
    color: var(--text-muted);
    font-size: 1rem;
  }

  /* --- team cards --- */
  .team-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
  }

  .tcard {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 1.5rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .tcard:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .tcard__media img,
  .tcard__ph {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    object-fit: cover;
    object-position: center top;
  }

  .tcard__ph {
    display: grid;
    place-items: center;
    background: linear-gradient(150deg, var(--navy-900), var(--slate-600));
    color: #fff;
    font-family: var(--font-display);
    font-size: 2rem;
    letter-spacing: 0.06em;
  }

  .tcard__creds {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--slate-600);
    margin: 0.3rem 0 0.85rem;
  }

  .tcard__lede {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 1.1rem;
  }

  /* --- visit --- */
  .visit {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(min(420px, 100%), 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .visit__facts {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: grid;
    gap: 1.5rem;
  }

  .visit__facts li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .visit__facts :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--slate-600);
  }

  .visit__facts strong {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate-600);
    margin-bottom: 0.25rem;
  }

  .visit__facts a {
    text-decoration: none;
    color: var(--text);
  }

  .visit__facts a:hover {
    color: var(--slate-600);
  }

  .visit__hours {
    display: block;
    font-size: 0.95rem;
  }

  .visit__form {
    min-width: 0;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .visit__form h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    margin-bottom: 0.6rem;
  }

  .visit__formNote {
    font-size: 0.92rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }

  /* Honeypot. Off screen rather than display:none so bots still fill it. */
  .hp {
    position: absolute;
    left: -9999px;
  }

  .field {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
    /* Grid items default to min-width:auto, which stops an input shrinking
       below its intrinsic width and overflows narrow screens. */
    min-width: 0;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .visit__form label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate-600);
  }

  /* Only the required marker, not every span inside a label. The consent
     sentence is wrapped in a span. */
  .visit__form label span[aria-hidden='true'] {
    color: #b4472f;
  }

  .visit__form input,
  .visit__form textarea {
    font: inherit;
    font-size: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
    color: var(--text);
    width: 100%;
    min-width: 0;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  .visit__form input:focus,
  .visit__form textarea:focus {
    outline: none;
    border-color: var(--slate-600);
    box-shadow: 0 0 0 3px rgba(76, 100, 122, 0.16);
  }

  .visit__form textarea {
    resize: vertical;
  }

  .consent {
    margin-bottom: 1.5rem;
  }

  .visit__form .consent__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem;
    align-items: start;
    font-size: 0.88rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-muted);
    line-height: 1.5;
    cursor: pointer;
  }

  .visit__form .consent__row input {
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.15rem;
    accent-color: var(--navy-900);
  }

  .visit__submit {
    width: 100%;
  }

  .visit__alt {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    text-align: center;
  }

  @media (max-width: 900px) {
    .hero__inner,
    .intro,
    .visit,
    .sec-head {
      grid-template-columns: 1fr;
    }
    .hero__copy {
      max-width: none;
    }

    /* Full width already, being outside the wrap. No negative bottom margin:
       the fade dissolves the image into the page, so it does not need to
       reach the section edge to feel part of it. */
    .hero__panel {
      position: static;
      width: auto;
      margin: 2.5rem 0 0;
    }

    /* Fades out at the bottom rather than the top, so his head stays whole.
       Taller crop gives the head room above and the fade room below. */
    .hero__panel img {
      aspect-ratio: 4 / 5;
      object-position: 58% 12%;
      -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 98%);
      mask-image: linear-gradient(to bottom, #000 62%, transparent 98%);
    }

    /* Out of the picture entirely and back into the page, so nothing sits
       over his face. */
    .hero__panel figcaption {
      position: static;
      margin: -1.5rem var(--gutter) 0;
      padding: 0 0 0 1rem;
      background: none;
      backdrop-filter: none;
      border-left: 3px solid var(--slate-600);
      border-radius: 0;
    }

    .hero__panel figcaption strong {
      font-size: 1.25rem;
      color: var(--navy-900);
    }

    .hero__panel figcaption span {
      font-size: 0.75rem;
      color: var(--slate-600);
    }
    .sec-head {
      align-items: start;
    }
  }

  /* The card is narrow well before the viewport is, so this collapses
     earlier than the 520px the full contact form uses. */
  @media (max-width: 720px) {
    .field-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  @media (max-width: 420px) {
    .tcard {
      grid-template-columns: 1fr;
    }
    .tcard__media {
      max-width: 170px;
    }
  }
</style>
