---
import Base from '../layouts/Base.astro';
import CTABanner from '../components/CTABanner.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Icon from '../components/Icon.astro';
import BookButton from '../components/BookButton.astro';
import { site } from '../data/site';
import { services, differentiators } from '../data/services';
import { team } from '../data/team';

const featured = services.slice(0, 6);
---

<Base>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Notasulga, Alabama</p>
        <h1>Relief today.<br /><em>Correction</em> that lasts.</h1>
        <p class="lede hero__lede">
          Outpatient orthopedic physical therapy, manual therapy, and sports medicine
          from clinicians who look past the symptom to the imbalance underneath it.
        </p>
        <div class="btn-row hero__actions">
          <BookButton />
          <a class="btn btn--ghost" href="/services/">Explore Services</a>
        </div>

        <ul class="hero__proof">
          <li><strong>50+</strong><span>Years combined experience</span></li>
          <li><strong>4</strong><span>Advanced manual therapy certifications</span></li>
          <li><strong>1:1</strong><span>Care with your clinician, every visit</span></li>
        </ul>
      </div>

      <div class="hero__panel" aria-hidden="true">
        <div class="hero__ring"></div>
        <img src="/logo-mark.png" alt="" width="325" height="453" />
      </div>
    </div>
  </section>

  <!-- ── Intro ────────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap intro">
      <div class="reveal">
        <p class="eyebrow">Our approach</p>
        <h2>Pain is the signal.<br />We go after the source.</h2>
      </div>
      <div class="stack reveal">
        <p class="lede">
          Most persistent pain is not a local problem. It is the end result of muscles
          that are overworked, muscles that stopped doing their job, and a body that has
          quietly reorganized itself around an old injury or a long day in a chair.
        </p>
        <p>
          At Corrective Bodyworks we combine advanced hands-on treatment with corrective
          exercise. The manual work brings relief quickly. The corrective work makes it
          stick. That means evaluating how you actually move, treating what we find, and
          giving you the specific tools to keep the problem from coming back.
        </p>
        <p>
          Whether you are an athlete, recovering from surgery, on your feet at work all
          day, or simply tired of hurting, you will be treated by an experienced licensed
          clinician who stays with you from evaluation through discharge.
        </p>
        <a class="arrow-link" href="/about/">
          More about the practice <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- ── Services ─────────────────────────────────────────────────────── -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="sec-head reveal">
        <div>
          <p class="eyebrow">What we do</p>
          <h2>Services</h2>
        </div>
        <p class="lede">
          A full range of rehabilitation and wellness care, delivered one patient at a
          time.
        </p>
      </div>

      <div class="grid cards">
        {featured.map((service) => <ServiceCard service={service} />)}
      </div>

      <div class="sec-foot reveal">
        <a class="btn btn--ghost" href="/services/">View all services</a>
      </div>
    </div>
  </section>

  <!-- ── Why us ───────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <div>
          <p class="eyebrow">Why Corrective Bodyworks</p>
          <h2>What makes us different</h2>
        </div>
      </div>

      <div class="grid diffs">
        {
          differentiators.map((item, i) => (
            <div class="diff reveal">
              <span class="diff__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Team ─────────────────────────────────────────────────────────── -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="sec-head reveal">
        <div>
          <p class="eyebrow">Meet the team</p>
          <h2>Who you'll see</h2>
        </div>
        <p class="lede">
          Two experienced clinicians who treat their own patients, personally.
        </p>
      </div>

      <div class="grid team-grid">
        {
          team.map((member) => (
            <a class="tcard reveal" href={`/team/#${member.slug}`}>
              <div class="tcard__media">
                {member.photo ? (
                  <img src={member.photo} alt={member.name} loading="lazy" width="600" height="800" />
                ) : (
                  <div class="tcard__ph">
                    <span>
                      {member.name
                        .split(' ')
                        .map((n) => n[0])
                        .join('')}
                    </span>
                  </div>
                )}
              </div>
              <div class="tcard__body">
                <h3>{member.name}</h3>
                <p class="tcard__creds">{member.credentials}</p>
                <p class="tcard__lede">{member.lede}</p>
                <span class="arrow-link">
                  Read bio <Icon name="arrow" size={18} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Visit ────────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap visit">
      <div class="reveal">
        <p class="eyebrow">Visit the clinic</p>
        <h2>Find us</h2>
        <ul class="visit__facts">
          <li>
            <Icon name="pin" size={22} />
            <div>
              <strong>Address</strong>
              <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
                {site.address.full}
              </a>
            </div>
          </li>
          <li>
            <Icon name="phone" size={22} />
            <div>
              <strong>Phone</strong>
              <a href={site.phoneHref}>{site.phone}</a>
            </div>
          </li>
          <li>
            <Icon name="clock" size={22} />
            <div>
              <strong>Hours</strong>
              {site.hours.map((h) => <span class="visit__hours">{h.day}: {h.time}</span>)}
            </div>
          </li>
        </ul>
      </div>

      <div class="visit__map reveal">
        <iframe
          src={site.mapsEmbedUrl}
          title="Map to Corrective Bodyworks"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <CTABanner />
</Base>

<style>
  /* --- hero --- */
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 7rem);
    background: linear-gradient(170deg, var(--bg-alt) 0%, #fff 62%);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--slate-600);
  }

  .hero__lede {
    margin-top: 1.5rem;
    max-width: 54ch;
  }

  .hero__actions {
    margin-top: 2.25rem;
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 3rem);
    list-style: none;
    padding: 2.5rem 0 0;
    margin-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .hero__proof li {
    display: grid;
    gap: 0.15rem;
  }

  .hero__proof strong {
    font-family: var(--font-display);
    font-size: 2.1rem;
    line-height: 1;
    color: var(--navy-900);
  }

  .hero__proof span {
    font-size: 0.85rem;
    color: var(--text-muted);
    max-width: 18ch;
  }

  .hero__panel {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
  }

  .hero__ring {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background: radial-gradient(
      circle at 40% 35%,
      rgba(76, 100, 122, 0.2),
      rgba(1, 27, 58, 0.07) 55%,
      transparent 74%
    );
  }

  /* Reads as a brand watermark rather than a second copy of the header
     wordmark. Swap this block for clinic photography when it's available. */
  .hero__panel img {
    position: relative;
    width: auto;
    height: 68%;
    opacity: 0.92;
  }

  /* --- shared section furniture --- */
  .sec-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 3rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .sec-foot {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: flex;
    justify-content: center;
  }

  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy-900);
    text-decoration: none;
  }

  .arrow-link :global(svg) {
    transition: transform 0.25s var(--ease);
  }

  .arrow-link:hover :global(svg) {
    transform: translateX(4px);
  }

  /* --- intro --- */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* --- cards --- */
  .cards {
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  }

  /* --- differentiators --- */
  .diffs {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .diff__num {
    display: block;
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--mist-200);
    margin-bottom: 0.75rem;
  }

  .diff h3 {
    margin-bottom: 0.6rem;
  }

  .diff p {
    color: var(--text-muted);
    font-size: 1rem;
  }

  /* --- team cards --- */
  .team-grid {
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }

  .tcard {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 1.5rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .tcard:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .tcard__media img,
  .tcard__ph {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    object-fit: cover;
    object-position: center top;
  }

  .tcard__ph {
    display: grid;
    place-items: center;
    background: linear-gradient(150deg, var(--navy-900), var(--slate-600));
    color: #fff;
    font-family: var(--font-display);
    font-size: 2rem;
    letter-spacing: 0.06em;
  }

  .tcard__creds {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--slate-600);
    margin: 0.3rem 0 0.85rem;
  }

  .tcard__lede {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 1.1rem;
  }

  /* --- visit --- */
  .visit {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .visit__facts {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: grid;
    gap: 1.5rem;
  }

  .visit__facts li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .visit__facts :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--slate-600);
  }

  .visit__facts strong {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate-600);
    margin-bottom: 0.25rem;
  }

  .visit__facts a {
    text-decoration: none;
    color: var(--text);
  }

  .visit__facts a:hover {
    color: var(--slate-600);
  }

  .visit__hours {
    display: block;
    font-size: 0.95rem;
  }

  .visit__map {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    aspect-ratio: 4 / 3;
  }

  .visit__map iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 900px) {
    .hero__inner,
    .intro,
    .visit,
    .sec-head {
      grid-template-columns: 1fr;
    }
    .hero__panel {
      display: none;
    }
    .sec-head {
      align-items: start;
    }
  }

  @media (max-width: 420px) {
    .tcard {
      grid-template-columns: 1fr;
    }
    .tcard__media {
      max-width: 170px;
    }
  }
</style>
