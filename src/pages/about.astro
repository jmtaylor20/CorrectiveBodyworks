---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTABanner from '../components/CTABanner.astro';
import Icon from '../components/Icon.astro';

const values = [
  {
    icon: 'balance',
    title: 'Find the real cause',
    body: 'Chasing symptoms produces temporary results. We evaluate the whole movement chain and treat the imbalance that put the strain there in the first place.',
  },
  {
    icon: 'hands',
    title: 'Hands-on, every visit',
    body: 'Skilled manual therapy is central to how we practice, not an add-on squeezed in at the end of a session spent on machines.',
  },
  {
    icon: 'activity',
    title: 'Care that is actually personal',
    body: 'One clinician, one plan, start to finish. We keep our schedule deliberately manageable so every patient gets real attention.',
  },
  {
    icon: 'check',
    title: 'Honest expectations',
    body: 'We will tell you what we think is going on, roughly how long it should take, and when something is outside our scope and needs a different provider.',
  },
];
---

<Base
  title="About"
  description="Corrective Bodyworks is a rehabilitation and wellness practice in Notasulga, Alabama, combining advanced manual therapy with corrective exercise to resolve pain at its source."
>
  <PageHero
    eyebrow="About the practice"
    title="Rehabilitation & wellness, done thoroughly"
    lede="Corrective Bodyworks was built around a simple frustration: too many people get treated for where it hurts, and nobody ever asks why it started hurting."
  />

  <section class="section">
    <div class="wrap about">
      <div class="stack reveal">
        <p class="lede">
          Corrective Bodyworks is an outpatient rehabilitation and wellness practice serving
          Notasulga, Tallassee, Auburn, and the surrounding communities.
        </p>
        <p>
          The practice grew out of owner Jeff Cotten's nearly three decades in sports
          medicine and orthopedic rehabilitation, and out of a pattern he kept running into:
          patients arriving after months of treatment that never addressed the mechanics
          behind their pain. Muscles that had gone quiet. Joints absorbing load they were
          never designed for. A body quietly compensating around an injury from years ago.
        </p>
        <p>
          So the practice was built to do both halves of the job. Advanced manual therapy
          (dry needling, Active Release Techniques, Primal Reflex Release, Fascial
          Manipulation) brings relief early, because pain makes everything else harder.
          Corrective exercise then rebuilds the movement patterns underneath, so the relief
          holds after discharge.
        </p>
        <p>
          With physical therapist Cameron Elliott joining the practice, Corrective Bodyworks
          brings more than fifty years of combined clinical experience to patients of every
          age and activity level, from youth athletes and runners to post-surgical patients
          and the "industrial athletes" whose jobs place real athletic demands on their
          bodies.
        </p>
      </div>

      <aside class="about__aside reveal">
        <h2 class="about__asideTitle">How we work</h2>
        <p>
          You will be evaluated carefully, treated by an experienced licensed clinician,
          and given a clear plan you understand. We measure our work by whether you are
          getting back to the things you want to do.
        </p>
        <p class="about__scripture">
          Our mark is a Tree of Andry, the old symbol of orthopedics: a young tree tied
          to a post so it can grow straight. We put a Cross in the post's place.
        </p>
      </aside>
    </div>
  </section>

  <section class="section section--deep mark">
    <div class="wrap wrap-narrow">
      <p class="eyebrow">The mark</p>
      <blockquote class="mark__quote">
        <p>
          The tree, tied to the post, represents correcting deformities in order to
          promote healthy growth. I believe that to truly accomplish this, our post
          that provides the strength to correct, change, and grow us is the Cross. I
          fully lean and depend on Christ as my source of strength, and the foundation
          of my practice.
        </p>
        <footer>
          <strong>Jeff Cotten</strong>
          <span>Owner, Corrective Bodyworks</span>
        </footer>
      </blockquote>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="reveal vals-head">
        <p class="eyebrow">How we practice</p>
        <h2>What we hold to</h2>
      </div>

      <div class="grid vals">
        {
          values.map((v) => (
            <div class="val reveal">
              <span class="val__icon"><Icon name={v.icon} size={24} /></span>
              <h3>{v.title}</h3>
              <p>{v.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTABanner
    heading="Let's find out what's actually going on"
    body="Reach out and tell us what you are dealing with. We will let you know whether we are the right fit."
  />
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .about__aside {
    background: var(--navy-900);
    color: var(--text-invert-muted);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border-radius: var(--radius-lg);
    position: sticky;
    top: 120px;
  }

  .about__asideTitle {
    color: #fff;
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .about__aside p + p {
    margin-top: 1rem;
  }

  .about__scripture {
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    font-style: italic;
    font-size: 0.95rem;
  }

  .mark {
    text-align: center;
  }

  .mark .eyebrow {
    justify-content: center;
  }

  .mark__quote {
    margin: 0;
  }

  .mark__quote p {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1.35;
    font-weight: 500;
    color: #fff !important;
    text-wrap: balance;
  }

  .mark__quote footer {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 1.75rem;
  }

  .mark__quote strong {
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    color: #fff;
  }

  .mark__quote span {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate-300);
  }

  .vals-head {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .vals {
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
  }

  .val__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #fff;
    color: var(--slate-600);
    margin-bottom: 1.15rem;
    box-shadow: var(--shadow-sm);
  }

  .val h3 {
    margin-bottom: 0.55rem;
  }

  .val p {
    color: var(--text-muted);
    font-size: 1rem;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__aside {
      position: static;
    }
  }
</style>
